{
  "name": "rms-hospital-api",
  "version": "1.0.0",
  "description": "Backend API for RMS Hospital Research Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "cross-env NODE_ENV=production node src/server.js",
    "dev": "cross-env NODE_ENV=development nodemon --trace-deprecation src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "cross-env REDIS_HOST=127.0.0.1 REDIS_PORT=1 node --test --test-force-exit \"test/**/*.test.js\"",
    "gen:jwt": "node scripts/gen-jwt-secrets.js",
    "check:routes": "node scripts/check-route-permissions.js",
    "gen:perm-types": "node scripts/gen-permission-types.js",
    "migrate:permissions": "node scripts/migrate-permissions.js",
    "flag:default-passwords": "node scripts/flag-default-passwords.js",
    "rename:trainee-usernames": "node scripts/rename-trainee-usernames.js",
    "dump:db-objects": "node scripts/dump-db-objects.js",
    "migrate": "node scripts/run-migrations.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.13",
    "otplib": "^13.5.0",
    "pino": "^9.14.0",
    "pino-roll": "^4.0.0",
    "sanitize-html": "^2.17.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "nodemon": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "$uuid"
  }
}
