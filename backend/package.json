{
  "name": "rms-hospital-api",
  "version": "1.0.0",
  "description": "Backend API for RMS Hospital Research Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "cross-env NODE_ENV=production node src/server.js",
    "dev": "cross-env NODE_ENV=development nodemon --trace-deprecation src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "cross-env REDIS_HOST=127.0.0.1 REDIS_PORT=1 node --test --test-force-exit \"test/**/*.test.js\"",
    "test:contract": "cross-env REDIS_HOST=127.0.0.1 REDIS_PORT=1 node --test --test-force-exit \"test/contract/**/*.test.js\"",
    "test:smoke": "node --test --test-force-exit --test-concurrency=1 \"test-integration/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "gen:jwt": "node scripts/gen-jwt-secrets.js",
    "check:routes": "node scripts/check-route-permissions.js",
    "check:requires": "node scripts/check-requires.js",
    "check:deps": "node scripts/check-deps.js",
    "gen:perm-types": "node scripts/gen-permission-types.js",
    "sync:permissions": "node scripts/sync-permissions.js",
    "flag:default-passwords": "node scripts/flag-default-passwords.js",
    "rename:trainee-usernames": "node scripts/rename-trainee-usernames.js",
    "rename:staff-usernames": "node scripts/rename-staff-usernames.js",
    "dump:db-objects": "node scripts/dump-db-objects.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:new": "node scripts/migrate.js new",
    "import:staff": "node scripts/import-staff.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "docxtemplater": "^3.71.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.2",
    "otplib": "^13.5.0",
    "pino": "^9.14.0",
    "pino-roll": "^4.0.0",
    "pizzip": "^3.3.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "nodemon": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "$uuid",
    "unzipper": "^0.12.5",
    "fast-csv": "^5.0.8",
    "glob": "^13.0.6"
  }
}
