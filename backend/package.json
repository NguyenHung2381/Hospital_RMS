{
  "name": "rms-hospital-api",
  "version": "1.0.0",
  "description": "Backend API for RMS Hospital Research Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "cross-env NODE_ENV=production node src/server.js",
    "dev": "cross-env NODE_ENV=development nodemon --trace-deprecation src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "cross-env REDIS_HOST=127.0.0.1 REDIS_PORT=1 node --test --test-force-exit \"test/**/*.test.js\"",
    "test:contract": "cross-env REDIS_HOST=127.0.0.1 REDIS_PORT=1 node --test --test-force-exit \"test/contract/**/*.test.js\"",
    "test:smoke": "node --test --test-force-exit --test-concurrency=1 \"test-integration/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "gen:jwt": "node scripts/gen-jwt-secrets.js",
    "check:routes": "node scripts/check-route-permissions.js",
    "check:requires": "node scripts/check-requires.js",
    "check:deps": "node scripts/check-deps.js",
    "gen:perm-types": "node scripts/gen-permission-types.js",
    "sync:permissions": "node scripts/sync-permissions.js",
    "flag:default-passwords": "node scripts/flag-default-passwords.js",
    "redact:activity-logs": "node scripts/redact-activity-logs.js",
    "sync:upload-paths": "node scripts/sync-upload-paths.js",
    "migrate": "node scripts/migrate.js",
    "pg:transfer": "node scripts/pg-transfer/index.js",
    "import:staff": "node scripts/import-staff.js",
    "test:pg": "node --test --test-force-exit --test-concurrency=1 \"test-integration-pg/**/*.test.js\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "docxtemplater": "^3.71.1",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-validator": "^7.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.7.13",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "pizzip": "^3.3.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "espree": "^11.2.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "$uuid",
    "unzipper": "^0.12.5",
    "fast-csv": "^5.0.8",
    "glob": "^14.0.3",
    "minimatch": "^11.0.4",
    "@azure/msal-node": "^7.1.1"
  }
}
