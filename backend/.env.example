PORT=3000

# docker-compose.yml (dev) đã tự set DB_SERVER=host.docker.internal, không cần
# tạo file .env này trừ khi muốn đổi user/password/db name.
#
# docker-compose.prod.yml thì LUÔN đọc backend/.env (bắt buộc để có DB_SERVER
# đúng). Nếu test prod-style ngay trên máy dev (SQL Server chạy trên host),
# dùng host.docker.internal như dưới đây. Khi deploy lên server thật, đổi
# DB_SERVER thành địa chỉ SQL Server thật.
# Ở production: KHÔNG dùng "sa" — tạo login riêng chỉ có quyền trên DB
# RMS_HOSPITAL bằng scripts/create-app-login.sql, rồi đặt DB_USER/DB_PASSWORD
# của login đó vào backend/.env.production (docker-compose.prod.yml nạp file
# này sau .env nên ghi đè được). docker-compose.prod.yml đã ép DB_ENCRYPT=true
# (DB_TRUST_SERVER_CERT=true nếu SQL Server dùng chứng chỉ tự ký, false nếu
# là CA công cộng).
DB_SERVER=host.docker.internal
DB_PORT=1413
DB_DATABASE=RMS_HOSPITAL
DB_USER=sa
DB_PASSWORD=123
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Bắt buộc — server sẽ không khởi động nếu thiếu các biến dưới đây.
# Đặt giá trị ngẫu nhiên, đủ dài (vd: openssl rand -hex 32), không dùng giá trị mẫu.
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
# Khoá mã hoá secret 2FA (AES-256-GCM), 64 ký tự hex. Bỏ trống = tự sinh file
# secrets/totp.key ở lần chạy đầu. KHÔNG đổi/xoay: đổi là mọi người dùng đã bật
# 2FA phải thiết lập lại. Sao lưu cùng DB.
# TOTP_ENC_KEY=
# Bắt buộc 2FA cho tài khoản quản trị (superuser hoặc vai trò có quyền "critical":
# tạo/sửa người dùng, sửa vai trò, phân quyền, cấu hình hệ thống). Lần đầu thuộc
# diện có TWOFA_GRACE_DAYS ngày (mặc định 14) để tự bật; quá hạn bị chặn tới khi bật.
# REQUIRE_2FA_FOR_ADMINS=false    # tắt hẳn yêu cầu này
# TWOFA_GRACE_DAYS=14
# Cloudflare Turnstile thay captcha phép tính ở form đăng ký công khai. Đặt cả 2
# khoá mới bật. Máy chủ phải gọi ra được https://challenges.cloudflare.com —
# không gọi được thì từ chối đăng ký (không bỏ qua kiểm tra).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Thời hạn access token (mặc định 15m). Refresh token: 7 ngày, 30 ngày nếu "ghi nhớ".
# JWT_EXPIRES_IN=15m
# Cookie refresh token (rms_rt) có cờ Secure: mặc định bật ở production, tắt ở dev.
# COOKIE_SECURE=true
# Swagger UI (/api-docs): bật ở dev, TẮT ở production trừ khi SWAGGER_ENABLED=true.
# SWAGGER_USER/SWAGGER_PASS chỉ bắt buộc khi Swagger bật.
SWAGGER_USER=admin
SWAGGER_PASS=change-me
# SWAGGER_ENABLED=true

# Link tải file /uploads được ký HMAC, có hạn (utils/signedUpload.js).
# UPLOAD_URL_SECRET không set = dùng JWT_SECRET. Đổi secret = mọi link cũ mất hiệu lực.
# UPLOAD_URL_SECRET=
# UPLOAD_URL_TTL_SEC=14400      # link sống từ 1× tới 2× giá trị này (mặc định 4h)

# Danh sách origin được phép gọi API (phân cách bởi dấu phẩy).
# Bỏ trống = cho phép mọi origin — CHỈ chấp nhận ở dev; ở production
# (NODE_ENV=production) server sẽ không khởi động nếu thiếu biến này.
# CORS_ORIGIN=https://rms.example.com,https://admin.rms.example.com

# Tuỳ chọn — số hop reverse-proxy đứng trước server (Nginx/IIS ARR/LB...).
# Bắt buộc set đúng khi deploy sau proxy, nếu không req.ip dùng để rate-limit
# login & khoá tài khoản sẽ luôn là IP của proxy (mất tác dụng), hoặc bị giả
# mạo qua X-Forwarded-For nếu set sai. Bỏ trống = không tin proxy nào (mặc
# định Express, đúng khi server nhận traffic trực tiếp như hiện tại).
# Dùng SỐ hop, không dùng "uniquelocal"/dải IP nội bộ: người dùng bệnh viện có
# IP nội bộ nên sẽ tự khai được X-Forwarded-For giả. Docker prod đặt sẵn = 1.
# TRUST_PROXY=1

# ─── Upload — module Đào tạo (hồ sơ học viên, tài liệu/video khóa học & bài học) ──
# Lưu đĩa cục bộ (uploads/training/...), không có cloud storage. Bỏ trống = mặc định.
# TOPIC_UPLOAD_MAX_MB=50       # hồ sơ đề tài NCKH (mặc định 50MB, trước đây 150MB)
# UPLOAD_DAILY_QUOTA_MB=2048   # hạn mức upload mỗi tài khoản mỗi ngày (0 = không giới hạn)
# Quét virus bằng ClamAV (clamd) — bỏ trống = tắt. Docker prod: CLAMAV_HOST=clamav + --profile av
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_MAX_MB=25             # file lớn hơn thì không quét (giới hạn luồng mặc định của clamd)
# CLAMAV_FAIL_OPEN=false       # true = vẫn nhận file khi ClamAV lỗi (mặc định từ chối)
# TRAINING_UPLOAD_MAX_MB=20    # hồ sơ học viên, minh chứng CME (mặc định 20MB)
# TRAINING_MEDIA_MAX_MB=300    # tài liệu/video khóa học & bài học (mặc định 300MB)

# ─── Activity log (file) ────────────────────────────────────────────────────
# Activity log KHÔNG còn ghi vào SQL Server. Server ghi ra file JSON xoay theo
# ngày tại LOG_DIR/audit-*.log; trang /activity-logs đọc thẳng từ các file này.
# Bỏ trống LOG_DIR = mặc định <thư mục backend>/logs (không phụ thuộc chỗ chạy).
# LOG_DIR=logs
LOG_RETENTION_FILES=90      # giữ tối đa 90 file (≈ 90 ngày), tự xoá file cũ hơn
# LOG_STDOUT=1              # ghi thẳng stdout thay vì file (khi có trình thu gom log riêng)
# AUDIT_LOG_METHODS=POST,PUT,PATCH,DELETE   # bỏ trống = ghi MỌI method (kể cả GET)

# ─── Email (tuỳ chọn) ────────────────────────────────────────────────────────
# Mặc định TẮT — chỉ log ra console, không gửi email thật. Bật bằng cách set
# MAIL_ENABLED=true kèm đủ SMTP_*. Dùng cho: thông báo duyệt/từ chối đề tài,
# nhắc deadline sắp tới (backend/src/jobs/deadlineReminderJob.js).
# MAIL_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=app-password
# SMTP_FROM="Hệ thống Quản lý NCKH <no-reply@example.com>"

# ─── Cache (Redis) ───────────────────────────────────────────────────────────
# Cache-aside cho dashboard + danh mục/lookup (departments, roles, categories,
# levels, round_types...) — tối ưu tốc độ đọc, không phải nguồn dữ liệu chính.
# docker-compose.yml đã tự set REDIS_HOST=redis (container "redis" cùng
# network), không cần khai báo ở đây khi chạy qua Docker. Chỉ set khi chạy
# native (không Docker) và Redis không nằm ở localhost:6379 mặc định.
# Nếu Redis không kết nối được, server vẫn chạy bình thường — chỉ đọc thẳng
# MSSQL, không cache (fail-open, xem backend/src/config/redis.js).
# REDIS_HOST=localhost
# REDIS_PORT=6379
# Mật khẩu Redis (--requirepass). docker-compose.prod.yml tự sinh và nạp qua
# REDIS_PASSWORD_FILE — chỉ đặt tay khi dùng Redis ngoài Docker có mật khẩu.
# REDIS_PASSWORD=

# ─── Cron job nền ────────────────────────────────────────────────────────────
# Nhắc deadline (2h sáng) + bảo trì tài khoản hết hạn/mật khẩu cũ (1h sáng).
# Đặt JOBS_ENABLED=false để tắt hẳn (vd môi trường test, hoặc chạy nhiều
# instance server và chỉ muốn 1 instance đảm nhiệm job).
# JOBS_ENABLED=false
# CRON_TZ=Asia/Ho_Chi_Minh
