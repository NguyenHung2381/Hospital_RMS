*.sql
# Ngoại lệ: migration schema + định nghĩa stored procedure / trigger / view đã
# được rà không chứa mật khẩu hay dữ liệu cá nhân — phải nằm trong git để review
# và tái lập môi trường.
!backend/migrations/*.sql
!backend/db/**/*.sql

