PORT=3000

# docker-compose.yml (dev) đã tự set DB_SERVER=host.docker.internal, không cần
# tạo file .env này trừ khi muốn đổi user/password/db name.
#
# docker-compose.prod.yml thì LUÔN đọc server/.env (bắt buộc để có DB_SERVER
# đúng). Nếu test prod-style ngay trên máy dev (SQL Server chạy trên host),
# dùng host.docker.internal như dưới đây. Khi deploy lên server thật, đổi
# DB_SERVER thành địa chỉ SQL Server thật.
DB_SERVER=host.docker.internal
DB_PORT=1433
DB_DATABASE=RMS_HOSPITAL
DB_USER=sa
DB_PASSWORD=123
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Bắt buộc — server sẽ không khởi động nếu thiếu các biến dưới đây.
# Đặt giá trị ngẫu nhiên, đủ dài (vd: openssl rand -hex 32), không dùng giá trị mẫu.
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
SWAGGER_USER=admin
SWAGGER_PASS=change-me

# Tuỳ chọn — danh sách origin được phép gọi API (phân cách bởi dấu phẩy).
# Bỏ trống = cho phép mọi origin (mặc định hiện tại, không đổi hành vi cũ).
# CORS_ORIGIN=https://rms.example.com,https://admin.rms.example.com
