PORT=3000

# docker-compose.yml (dev) đã tự set DB_SERVER=host.docker.internal, không cần
# tạo file .env này trừ khi muốn đổi user/password/db name.
#
# docker-compose.prod.yml thì LUÔN đọc server/.env (bắt buộc để có DB_SERVER
# đúng). Nếu test prod-style ngay trên máy dev (SQL Server chạy trên host),
# dùng host.docker.internal như dưới đây. Khi deploy lên server thật, đổi
# DB_SERVER thành địa chỉ SQL Server thật.
DB_SERVER=host.docker.internal
DB_PORT=1433
DB_DATABASE=RMS_HOSPITAL
DB_USER=sa
DB_PASSWORD=123
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Bắt buộc — server sẽ không khởi động nếu thiếu các biến dưới đây.
# Đặt giá trị ngẫu nhiên, đủ dài (vd: openssl rand -hex 32), không dùng giá trị mẫu.
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
SWAGGER_USER=admin
SWAGGER_PASS=change-me

# Tuỳ chọn — danh sách origin được phép gọi API (phân cách bởi dấu phẩy).
# Bỏ trống = cho phép mọi origin (mặc định hiện tại, không đổi hành vi cũ).
# CORS_ORIGIN=https://rms.example.com,https://admin.rms.example.com

# ─── Activity log (file) ────────────────────────────────────────────────────
# Activity log KHÔNG còn ghi vào SQL Server. Server ghi ra file JSON xoay theo
# ngày tại LOG_DIR/audit-*.log; trang /activity-logs đọc thẳng từ các file này.
# Bỏ trống LOG_DIR = mặc định <thư mục server>/logs (không phụ thuộc chỗ chạy).
# LOG_DIR=logs
LOG_RETENTION_FILES=90      # giữ tối đa 90 file (≈ 90 ngày), tự xoá file cũ hơn
# LOG_STDOUT=1              # ghi thẳng stdout thay vì file (khi có trình thu gom log riêng)
# AUDIT_LOG_METHODS=POST,PUT,PATCH,DELETE   # bỏ trống = ghi MỌI method (kể cả GET)

# ─── Email (tuỳ chọn) ────────────────────────────────────────────────────────
# Mặc định TẮT — chỉ log ra console, không gửi email thật. Bật bằng cách set
# MAIL_ENABLED=true kèm đủ SMTP_*. Dùng cho: thông báo duyệt/từ chối đề tài,
# nhắc deadline sắp tới (server/src/jobs/deadlineReminderJob.js).
# MAIL_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=app-password
# SMTP_FROM="Hệ thống Quản lý NCKH <no-reply@example.com>"

# ─── Cron job nền ────────────────────────────────────────────────────────────
# Nhắc deadline (2h sáng) + bảo trì tài khoản hết hạn/mật khẩu cũ (1h sáng).
# Đặt JOBS_ENABLED=false để tắt hẳn (vd môi trường test, hoặc chạy nhiều
# instance server và chỉ muốn 1 instance đảm nhiệm job).
# JOBS_ENABLED=false
# CRON_TZ=Asia/Ho_Chi_Minh
